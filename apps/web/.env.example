# MyFinanceOS — Web app environment template
# Copy to .env and fill in real values. All variables are NEXT_PUBLIC_* by
# design: the app is local-first and holds no server-only secrets. Do NOT
# introduce a SUPABASE_SERVICE_ROLE_KEY here — it must never reach the client.

# Google OAuth client ID (cloud sync sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase project (auth + optional encrypted cloud sync)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog product analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Contact form (hosted landing page)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
