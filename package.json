{
  "name": "financeos-india",
  "version": "1.1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "preview:screenshot": "node scripts/screenshot.mjs",
    "build": "npm --prefix apps/web run build",
    "build:libs": "npm --prefix packages/shared run build && npm --prefix packages/auth run build && npm --prefix packages/database run build && npm --prefix packages/ui run build",
    "start": "npm --prefix apps/web run start",
    "lint": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "node scripts/release.mjs",
    "release:ship": "node scripts/release.mjs --ship",
    "push": "node scripts/release.mjs --ship",
    "release:preview": "node scripts/release.mjs --preview",
    "release:auto": "node scripts/release.mjs --auto",
    "release:patch": "node scripts/release.mjs --patch",
    "release:minor": "node scripts/release.mjs --minor",
    "release:major": "node scripts/release.mjs --major",
    "release:none": "node scripts/release.mjs --none",
    "release:check": "node scripts/release.mjs --check",
    "version:check": "node scripts/release.mjs --check-version",
    "changelog:check": "node scripts/release.mjs --check-changelog",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "@vitest/coverage-v8": "^1.2.0",
    "chrome-devtools-mcp": "1.8.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.42.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.24.0",
    "vitest": "^1.3.0"
  }
}
