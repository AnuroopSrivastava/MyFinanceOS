{
  "name": "financeos-india",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "preview:screenshot": "node scripts/screenshot.mjs",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "@vitest/coverage-v8": "^1.2.0",
    "chrome-devtools-mcp": "1.8.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.42.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.24.0",
    "vitest": "^1.3.0"
  }
}
